axis_input:
  Bindings:
    Jump:
      Key: Space
      Gamepad: ButtonA
    MoveForward:
      Key: W
      Gamepad: ButtonDpadUp
    MoveBackward:
      Key: S
      Gamepad: ButtonDpadDown
    MoveLeft:
      Key: A
      Gamepad: ButtonDpadLeft
    MoveRight:
      Key: D
      Gamepad: ButtonDpadRight
    Shoot:
      Gamepad: ButtonRightBumper
    Interact:
      Key: E
      Gamepad: ButtonX
    Pause:
      Key: P
      Gamepad: ButtonStart
    Crouch:
      Key: LeftControl
      Gamepad: ButtonRightThumb
    Sprint:
      Key: LeftShift
      Gamepad: ButtonLeftThumb
    LoadNextScene:
      Key: I
    ReloadScene:
      Key: O
    AnimPlayPrimary:
      Key: Z
      Gamepad: ButtonA
    AnimPlaySecondary:
      Key: X
      Gamepad: ButtonX
    AnimCrossfadeSec:
      Key: C
    AnimCrossfadePri:
      Key: V
    AnimSpeedDown:
      Key: B
    AnimSpeedUp:
      Key: N
    AnimSpeedReset:
      Key: M
    Select:
      Mouse: Right
      Mouse: WheelUp
      Mouse: WheelDown
      Mouse: Button4
      Mouse: Button5
    ToggleBGM:
      Key: 1
    Toggle2DSound:
      Key: 2
    VolumeUp:
      Key: Equals
    VolumeDown:
      Key: Minus
    ToggleParticle:
      Key: 3
    MoveTo:
      Mouse: Left
