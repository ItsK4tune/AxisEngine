@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")
list(PREPEND CMAKE_PREFIX_PATH "${PACKAGE_PREFIX_DIR}")
find_dependency(ASSIMP)
find_dependency(GLFW3)
find_dependency(GLM)
find_dependency(EnTT)
find_dependency(STB)
if(@ENABLE_EDITOR@)
    find_dependency(ImGui)
endif()
if(@AXIS_HAS_BULLET_BACKEND@)
    find_dependency(Bullet)
endif()
find_dependency(Freetype)
if(@AXIS_HAS_IRRKLANG_BACKEND@)
    find_dependency(IrrKlang)
endif()
if(@AXIS_HAS_FMOD_BACKEND@)
    find_dependency(FMOD)
endif()
find_dependency(FFMPEG)
find_dependency(Enet)
if(@AXIS_HAS_OPENGL_BACKEND@)
    find_dependency(Glad)
endif()
list(POP_FRONT CMAKE_PREFIX_PATH)
list(POP_FRONT CMAKE_MODULE_PATH)

include("${CMAKE_CURRENT_LIST_DIR}/AxisEngineTargets.cmake")

check_required_components(AxisEngine)
